{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run i18n:build && npm run openapi:generate && ng serve --proxy-config proxy.conf.json",
    "build": "npm run i18n:build && npm run openapi:generate && ng build && node scripts/preload-initial.mjs && node scripts/precompress.mjs",
    "watch": "ng build --watch --configuration development",
    "openapi:generate": "node scripts/generate-api.mjs && node scripts/mark-api-pure.mjs",
    "lint": "eslint \"src/**/*.{ts,html}\" && node scripts/check-data-state.mjs && node scripts/check-theme-tokens.mjs && node scripts/check-date-inputs.mjs",
    "i18n:build": "node scripts/build-i18n.mjs",
    "i18n:check": "node scripts/build-i18n.mjs && node scripts/check-i18n.mjs",
    "pretest": "npm run i18n:build && npm run openapi:generate",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"scripts/**/*.mjs\""
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@angular/ssr": "^22.2.5",
    "@fontsource-variable/inter": "5.3.0",
    "@openng/icons": "1.0.0",
    "@openng/optimus-ui": "2.0.2",
    "@openng/optimus-ui-themes": "2.0.2",
    "@stomp/stompjs": "7.5.0",
    "dompurify": "^3.4.17",
    "leaflet": "^1.9.4",
    "marked": "^18.1.2",
    "pmtiles": "3.2.1",
    "protomaps-leaflet": "5.1.0",
    "quill": "2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@types/leaflet": "^1.9.22",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "glob": "^14.0.2",
    "basic-ftp": "^6.2.1",
    "lodash.isequal": "npm:fast-deep-equal@3.1.3"
  }
}
