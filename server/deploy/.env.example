# Template for server/deploy/.env (copy, chmod 600, fill in). Every variable is described in docs/secrets.md.
# Lines left commented keep the default / leave the feature off.

# --- compose ---
IMAGE=ghcr.io/epsuchti/foodsharing-platform
VERSION=44
# HTTP_BIND=127.0.0.1:8080

# --- database ---
POSTGRES_PASSWORD=change-me
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/foodsharing
SPRING_DATASOURCE_USERNAME=foodsharing
SPRING_DATASOURCE_PASSWORD=change-me
# DB_POOL_SIZE=20

# --- application ---
APP_DOMAIN=foodsharing.example.org
APP_BASE_URL=https://foodsharing.example.org
APP_IP_SALT=change-me
APP_SIGNING_SECRET=change-me
NEWSLETTER_SECRET=change-me
OAUTH_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
# MAIL_FROM=noreply@foodsharing.network
# UPLOADS_DIR=/data/uploads
# PHOTON_URL=https://photon.komoot.io
# MANAGEMENT_PORT=9090
# APP_VERSION=set-by-image
# APP_VERSION_FILE=/app/version.txt

# --- mail (ProtonMail SMTP token) ---
# SMTP_HOST=smtp.protonmail.ch
# SMTP_PORT=587
SMTP_USERNAME=noreply@foodsharing.network
SMTP_PASSWORD=change-me

# --- push / telegram ---
PUSH_VAPID_PUBLIC=change-me
PUSH_VAPID_PRIVATE=change-me
# PUSH_VAPID_SUBJECT=mailto:it@foodsharing.network
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_NAME=foodsharing_bot
# TELEGRAM_WEBHOOK_SECRET=

# --- mailbox (inbound mail; off with MAILBOX_INBOUND=log) ---
# MAILBOX_INBOUND=log
# MAILBOX_DOMAIN=
# MAILBOX_IMAP_HOST=
# MAILBOX_IMAP_USER=
# MAILBOX_IMAP_PASSWORD=
# MAILBOX_WEBHOOK_SECRET=

# --- wallet passes (off) ---
# APPLE_WALLET_PASS_TYPE_ID=
# APPLE_WALLET_TEAM_ID=
# APPLE_WALLET_CERTIFICATE_P12=
# APPLE_WALLET_CERTIFICATE_PASSWORD=
# APPLE_WALLET_WWDR_CERTIFICATE=
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_CLASS_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
