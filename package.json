{
  "name": "foodsharing-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Repo-level tooling: contract checks and Playwright e2e entry points. The app is built by server/pom.xml.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:openapi": "node scripts/check-openapi.mjs",
    "oasdiff": "bash scripts/oasdiff.sh",
    "er-diagram": "bash scripts/er-diagram.sh",
    "e2e:install": "npm --prefix e2e ci && npm --prefix e2e exec -- playwright install",
    "e2e": "npm --prefix e2e exec -- playwright test",
    "e2e:chromium": "npm --prefix e2e exec -- playwright test --project=chromium",
    "e2e:ui": "npm --prefix e2e exec -- playwright test --ui",
    "e2e:screenshots": "bash e2e/scripts/screenshots.sh",
    "e2e:coverage": "node e2e/scripts/feature-coverage.mjs",
    "e2e:typecheck": "npm --prefix e2e exec -- tsc --noEmit -p ."
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.42.0",
    "yaml": "^2.9.1"
  }
}
