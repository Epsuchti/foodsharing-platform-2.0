{
  "name": "foodsharing-platform-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Playwright end-to-end and screenshot tests against the packaged jar (plan.md §18.3/§18.4).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "screenshots": "bash scripts/screenshots.sh",
    "coverage": "node scripts/feature-coverage.mjs",
    "coverage:strict": "node scripts/feature-coverage.mjs --strict",
    "typecheck": "tsc --noEmit -p .",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.6.0",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "yaml": "^2.9.1"
  }
}
